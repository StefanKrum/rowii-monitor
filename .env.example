ROWII_DATA_ROOT=~/AI Workspace/master-thesis/data
ROWII_RESULTS_ROOT=./results
ROWII_BEATS_CHECKPOINT=
# Frozen TF-C checkpoints (audio-tfc / vibration-tfc variants, package-4) -- two
# independent files, one per branch (models/pretrained/tfc/tfc_audio.pt / tfc_vib.pt).
ROWII_TFC_AUDIO_CHECKPOINT=
ROWII_TFC_VIB_CHECKPOINT=
# Distilled BEATs-student checkpoint (audio-student variant, package-5) -- ONE
# audio-only file (models/adapted/student_<run>.pt, scripts/distill_beats.py).
ROWII_STUDENT_CHECKPOINT=
# Post-training INT8-quantized BEATs checkpoint (audio-beats/fusion-beats variants,
# package-5) -- a module pickle from scripts/quantize_beats.py (models/adapted/
# beats_int8.pt), NOT the {"cfg","model"} state-dict format ROWII_BEATS_CHECKPOINT
# points at. When set, BeatsFeaturizer loads THIS instead of the fp32 checkpoint and
# forces CPU-only inference (dynamic-quantized kernels have no MPS/CUDA backend).
ROWII_BEATS_INT8_CHECKPOINT=
# Cross-attention fusion-head checkpoint (scripts/train_xattn.py output; backs
# scripts/run_step2.py --xattn-fusion). Leave empty to disable the view.
ROWII_XATTN_CHECKPOINT=
